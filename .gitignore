# Результаты сборки лежат в output/ и не версионируются — они полностью
# воспроизводятся командой `python src/build.py`.
output/

# Python
__pycache__/
*.py[cod]
*.pyo

# Виртуальные окружения
.venv/
venv/
env/

# Сырые генерации ElevenLabs: по четыре варианта на каждый ассет, десятки
# мегабайт. В репозиторий попадают только отобранные файлы уровнем выше.
assets/**/archive/

# Живая запись голоса исполнителя: 147 файлов на 138 МБ и растёт с каждой
# новой репликой. Это сырьё того же рода, что генерации выше, и версионировать
# его так же незачем.
#
# Ничего важного при этом не теряется: какой дубль признан лучшим, кем выбран,
# сколько длится и чист ли по уровню — записано в scenario/takes_chosen.json,
# а он версионируется. Разделение сознательное: решения в гит, сырьё нет.
assets/voices/my/

# Купленный видеоматериал: сотни мегабайт, и он куплен по лицензии — в
# репозитории ему не место. Что именно нужно и куда класть — в
# docs/video-shopping-list.md, список кадров — в scenario/shots.json.
#
# Исключение идёт по расширениям, а не папкой целиком: папку git не обходит
# вовсе, и тогда ни .gitkeep, ни подтверждения лицензий в проект не попадут,
# сколько отрицаний ни пиши.
assets/video/**/*.mp4
assets/video/**/*.mov
assets/video/**/*.webm
assets/video/**/*.mkv
assets/video/**/*.avi
assets/video/**/*.mxf

# Кадры из официального трейлера «Lohen: A Masterpiece» и официальный арт.
# Они нужны как референсы на вход генерации, но это чужой материал — в
# репозиторий ему не место. Что за что отвечает, записано в
# assets/screenshots/MANIFEST.md, и он версионируется: разбор кадров дороже
# самих кадров, а сами кадры пересобираются из трейлера за десять минут.
#
# Исключение по расширениям, а не папкой: иначе git не обойдёт папку и
# MANIFEST.md вместе с .gitkeep в проект не попадут.
assets/screenshots/**/*.png
assets/screenshots/**/*.jpg
assets/screenshots/**/*.jpeg
assets/screenshots/**/*.webp

# Кадры разбора тренировок. 115 МБ на один заход против 38 МБ самих видео —
# они втрое тяжелее исходников и пересобираются одной командой:
#     python motion/analyze.py --force
# В репозитории остаются report.md и measurements.json (90 КБ): по ним и
# сравниваются заходы между собой, а картинки нужны только пока их смотрят.
# Сами видео в гит идут — это решение заказчика, см. проектное решение, п. 12.
train/reports/**/frames/

# Модель позы MediaPipe: 9 МБ чужого бинарника, который скачивается одной
# командой из официального хранилища Google. В репозиторий ему не место по той
# же причине, по которой там нет купленного видео. Как получить — motion/README.md.
motion/models/

# Сведение номера в REAPER, вторая версия звука — assets/mix_v2/.
#
# В гит идёт то, чего больше нигде нет: сам проект .rpp с расстановкой и
# обработкой, его автосохранения и девятнадцать купленных mp3, из которых
# собраны ручные FX. Это восемь мегабайт и всё содержание работы.
#
# Не идёт то, что уже есть в проекте и воспроизводится:
#
# 53 дорожки по 17 МБ — наш же экспорт под REAPER, каждая ровно
# шестидесятисекундная. Сверено по хешу: совпадает с output/reaper_stems
# бит в бит. Класть их второй раз значит положить 916 МБ копии.
assets/mix_v2/Media/[0-9][0-9][0-9].[0-9][0-9]_*.wav
assets/mix_v2/Media/_reference_music_ducked.wav
#
# Ролик, под который сводили, — наша же сборка final_ru_nostrip_titles.mp4,
# сверено по хешу.
assets/mix_v2/Media/final_ru_nostrip_titles.mp4
#
# Кэш формы волны REAPER: строится сам при первом открытии проекта.
*.reapeaks

# Прежние листы движений, версия Gemini — site/sheets/old/.
#
# Они лежат тут для сравнения с нынешними, от ChatGPT. Второй раз в гит не идут:
# оригиналы уже лежат в его истории, коммит a6a7875, и достаются оттуда одной
# командой. Плюс папка внутри site/, а это публикуемая часть: незачем раздавать
# с Pages шесть мегабайт того, что заменено.
site/sheets/old/

# Отдельные позы, нарезанные из листов — assets/sheets/panels/.
#
# Производное, а не источник: пересобирается из самих листов одной командой
#     python tools/cut_panels.py
# а рамки, по которым режется, лежат в самом скрипте и версионируются. Класть
# в гит ещё и результат значит хранить одно и то же дважды.
assets/sheets/panels/

# Тренировочные клипы — assets/train_clips/.
#
# Референс движения для репетиций, не часть номера. В гит не идут по той же
# причине, по которой там нет купленного видео: это мегабайты, которые
# восстанавливаются без повторной оплаты — prediction_id каждой попытки лежит
# в docs/atlas-ledger.csv, и результат забирается обратно командой
#     python tools/atlas_train.py --refetch <prediction_id> --as <клип>
assets/train_clips/

# Заявка на конкурс — application/.
#
# Слепок отправленной формы и всё, что к ней приложено. В репозиторий не идёт
# целиком, и это про личные данные, а не про размер: там полное имя, телефон,
# почта и фотографии. Такому в общем репозитории не место, даже в приватном.
#
# Папкой, а не по расширениям: здесь нет ничего, что стоило бы версионировать
# выборочно, — вся ценность папки в том, что она хранит отправленное как есть.
application/

# Служебное
.DS_Store
Thumbs.db
desktop.ini
